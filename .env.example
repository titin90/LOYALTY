# --- Base de datos -----------------------------------------------------------
# Conexión directa para migraciones y tests. NUNCA apuntar a producción en local.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role salta RLS por completo. Solo se usa en scripts de operación y
# tests de aislamiento — JAMAS en codigo de aplicacion (CLAUDE.md regla 3).
SUPABASE_SERVICE_ROLE_KEY=

# --- Escáner del local -------------------------------------------------------
# Firma las credenciales del dispositivo. Mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
DEVICE_TOKEN_SECRET=
# Firma la sesión del panel. Si falta, cae a DEVICE_TOKEN_SECRET.
SESSION_SECRET=
APP_URL=http://localhost:3000

# --- Apple Wallet ------------------------------------------------------------
# Sin estas variables la plataforma se declara no disponible y la interfaz lo
# dice; la aplicación funciona igual. Requiere Apple Developer Program.
APPLE_PASS_TYPE_ID=pass.cl.tudominio.loyalty
APPLE_TEAM_ID=
# Certificado Pass Type ID exportado como .p12:  base64 -i cert.p12
APPLE_PASS_CERT_P12_BASE64=
APPLE_PASS_CERT_PASSWORD=
# Intermedio Apple Worldwide Developer Relations, en PEM (o su base64)
APPLE_WWDR_CERT_PEM=
# Llave de APNs (.p8) para avisar de cambios en el pase:  base64 -i AuthKey.p8
APPLE_APNS_KEY_P8_BASE64=
APPLE_APNS_KEY_ID=

# --- Google Wallet -----------------------------------------------------------
# El issuer account requiere aprobación de Google y tarda días: inícialo pronto.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# --- Cron de Vercel ----------------------------------------------------------
# Protege /api/cron/retention, que borra datos de forma irreversible.
# Generar con: openssl rand -base64 32
CRON_SECRET=

# --- Observabilidad ----------------------------------------------------------
SENTRY_DSN=
